# ReportGPS Extraction Pipeline — Environment Variables
# Copy this file to .env and fill in your API keys.

# ── AI Verifier (Master Switch) ───────────────────────────────────────────────
# Set true to enable AI-powered false-positive filtering via LLM.
# Set false to skip verification — all deterministic violations returned as-is.
VERIFIER_ENABLED=true

# ── Groq (PRIMARY LLM) ─────────────────────────────────────────────────────
# Free tier: 30 RPM / 14,400 requests per day — Llama 3.3 70B
# Sign up free: https://console.groq.com
# Add up to 3 more keys for load balancing (each key adds 30 RPM).
GROQ_API_KEY=gsk_your_primary_key_here
GROQ_API_KEY_2=gsk_your_second_key_here
GROQ_API_KEY_3=gsk_your_third_key_here
GROQ_API_KEY_4=gsk_your_fourth_key_here

# ── Cerebras (FALLBACK) ────────────────────────────────────────────────────
# Free tier: 30 RPM / 1M tokens per day — fastest inference hardware
# Sign up free: https://cloud.cerebras.ai
CEREBRAS_API_KEY=csk_your_cerebras_key_here

# ── Gemini (LAST RESORT) ───────────────────────────────────────────────────
# Only used if both Groq and Cerebras fail or are rate-limited.
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza_your_gemini_key_here

# ── Reference Analyser Microservice ──────────────────────────────────────
# URL of the reference quality analyser (Checks 1–6).
REFERENCE_ANALYSER_URL=http://localhost:8002

# ── Verifier Tuning (optional — defaults shown) ───────────────────────────
# LLM sampling temperature for violation verification (low = more consistent)
VERIFIER_TEMPERATURE=0.1
# LLM sampling temperature for phrasing the human-readable violation messages
# PHRASING_TEMPERATURE=0.2

# Timeout per LLM request in seconds
VERIFIER_TIMEOUT=60

# Number of retries on LLM timeout or 500 error
VERIFIER_MAX_RETRIES=3

# When true, the verifier also rewrites violations into human-readable language
PHRASING_ENABLED=true

# Override the LLM model (leave blank to use each provider's best default)
# VERIFIER_MODEL=llama-3.3-70b-versatile
# PHRASING_MODEL=

# Skip LLM if detector confidence >= this threshold (1.01 = always verify)
# SKIP_VERIFIER_CONFIDENCE_THRESHOLD=1.01

# ── Debug Options ─────────────────────────────────────────────────────────
# Emit all verifier candidates to the response JSON (for debugging)
# VERIFIER_DEBUG_CANDIDATES=false
# Write a JSONL audit log of all verifier calls (blank = disabled)
# VERIFIER_LOG_PATH=verifier_log.jsonl
