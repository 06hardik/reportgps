# ReportGPS Extraction Pipeline — Environment Variables

# ── AI Verifier ───────────────────────────────────────────────────────────────
# Set VERIFIER_ENABLED=true to enable AI-powered false-positive filtering.
# When disabled, all deterministic violations are returned as-is (~0.5s faster).
VERIFIER_ENABLED=false

# Groq API key (used when VERIFIER_ENABLED=true, primary LLM: Llama-3)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Google Gemini API key (used as fallback when Groq is unavailable)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza_your_key_here

# ── Optional Tuning ───────────────────────────────────────────────────────────
# LLM provider to use: "groq" or "gemini" (default: groq)
# VERIFIER_PROVIDER=groq

# Max violations to send to the LLM per request (default: 10)
# VERIFIER_MAX_VIOLATIONS=10
